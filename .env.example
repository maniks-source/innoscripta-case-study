# Optional. https://open-platform.theguardian.com/access/
# Without a key, Briefing uses The Guardian's public RSS feeds.
GUARDIAN_API_KEY=

# Optional. https://developer.nytimes.com/
# Without a key, Briefing uses NYT public RSS feeds.
NYT_API_KEY=

# Optional. Enables the NewsAPI.org adapter. https://newsapi.org/register
NEWSAPI_API_KEY=

# Used by the API server in development. Docker overrides this to 8080.
PORT=5174
